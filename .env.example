# Copy to .env and fill in. Never commit .env.
# Which AI provider: gemini (default) or openai_compatible (e.g. Meta Muse Spark)
LLM_PROVIDER=gemini

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# OpenAI-compatible provider, used when LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Supabase (backend only). Never put these in frontend/ or commit .env.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Supabase dashboard -> Connect -> Session pooler. Change "postgresql://" to "postgresql+psycopg://".
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Comma-separated list of sites allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173
