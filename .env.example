# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (backend only). Never put these in frontend/ or commit .env.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Supabase dashboard -> Connect -> Session pooler. Change "postgresql://" to "postgresql+psycopg://".
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Comma-separated list of sites allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173
